---
import Button from '../components/Button.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found" description="This page does not exist.">
  <div class="container-page py-32 text-center">
    <p class="eyebrow">404</p>
    <h1 class="mt-4 text-4xl font-semibold tracking-tight md:text-5xl">Page not found</h1>
    <p class="mt-4 text-muted">The page you're looking for doesn't exist or has moved.</p>
    <div class="mt-8 flex justify-center">
      <Button href="/">Back home</Button>
    </div>
  </div>
</BaseLayout>
