---
import { getCollection } from 'astro:content';
import ProjectCard from '../../components/ProjectCard.astro';
import { profile } from '../../data/profile';
import BaseLayout from '../../layouts/BaseLayout.astro';

const projects = (await getCollection('projects', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);
---

<BaseLayout title={`Projects | ${profile.name}`} description="Selected projects and case studies.">
  <div class="container-page py-20 md:py-28">
    <header class="mb-12">
      <p class="eyebrow">Projects</p>
      <h1 class="mt-3 text-4xl font-semibold tracking-tight md:text-5xl">Things I've built</h1>
    </header>
    <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
      {projects.map((project) => <ProjectCard project={project} />)}
    </div>
  </div>
</BaseLayout>
