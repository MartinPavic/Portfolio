---
import { profile } from '../data/profile';
import Icon from './Icon.astro';
---

<footer class="border-t border-border py-10">
  <div
    class="container-page flex flex-col items-center justify-between gap-4 text-sm text-muted sm:flex-row"
  >
    <p>&copy; {new Date().getFullYear()} {profile.name}. Built with Astro.</p>
    <ul class="flex items-center gap-5">
      <li>
        <a href={profile.github} class="transition-colors hover:text-fg" aria-label="GitHub" target="_blank" rel="noopener noreferrer">
          <Icon name="github" class="size-5" />
        </a>
      </li>
      <li>
        <a href={profile.linkedin} class="transition-colors hover:text-fg" aria-label="LinkedIn" target="_blank" rel="noopener noreferrer">
          <Icon name="linkedin" class="size-5" />
        </a>
      </li>
      <li>
        <a href={`mailto:${profile.email}`} class="transition-colors hover:text-fg" aria-label="Email">
          <Icon name="mail" class="size-5" />
        </a>
      </li>
    </ul>
  </div>
</footer>
