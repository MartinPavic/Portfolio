---
interface Props {
  id: string;
  eyebrow: string;
  title: string;
}

const { id, eyebrow, title } = Astro.props;
---

<section id={id} class="py-20 md:py-28">
  <div class="container-page">
    <header class="reveal mb-12">
      <p class="eyebrow">{eyebrow}</p>
      <h2 class="mt-3 text-3xl font-semibold tracking-tight md:text-4xl">{title}</h2>
    </header>
    <slot />
  </div>
</section>
